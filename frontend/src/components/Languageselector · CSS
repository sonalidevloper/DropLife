/* LanguageSelector.css */
.lang-selector { position: relative; }

.lang-trigger {
  display: flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 7px 10px;
  cursor: pointer;
  transition: var(--transition-fast);
  color: var(--text-secondary);
  font-family: var(--font-body);
  font-size: 13px;
}
.lang-trigger:hover { background: rgba(255,255,255,0.08); color: var(--text-primary); border-color: rgba(255,255,255,0.15); }
.lang-flag { font-size: 16px; line-height: 1; }
.lang-name { font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
.lang-chevron { font-size: 11px; color: var(--text-muted); }
.compact .lang-trigger { padding: 6px 8px; }

.lang-dropdown {
  position: absolute; top: 44px; right: 0;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  width: 260px;
  box-shadow: var(--shadow-card);
  z-index: 500;
  animation: fadeInUp 0.2s ease;
  overflow: hidden;
}
.lang-search {
  position: relative; display: flex; align-items: center;
  padding: 12px;
  border-bottom: 1px solid var(--border);
}
.lang-search-icon {
  position: absolute; left: 24px;
  font-size: 14px; pointer-events: none;
}
.lang-search-input {
  width: 100%;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 8px 12px 8px 36px;
  color: var(--text-primary);
  font-size: 13px;
  font-family: var(--font-body);
  outline: none;
}
.lang-search-input:focus { border-color: var(--red-primary); }
.lang-search-input::placeholder { color: var(--text-muted); }

.lang-list {
  max-height: 320px;
  overflow-y: auto;
  padding: 8px 0;
}
.lang-list::-webkit-scrollbar { width: 4px; }
.lang-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

.lang-region-label {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  padding: 10px 16px 6px;
}
.lang-option {
  display: flex; align-items: center; gap: 10px;
  width: 100%; padding: 9px 16px;
  background: none; border: none; cursor: pointer;
  transition: background 0.15s;
  color: var(--text-primary);
  font-family: var(--font-body);
  text-align: left;
}
.lang-option:hover { background: rgba(255,255,255,0.05); }
.lang-option.active { background: rgba(227,27,35,0.08); }
.lang-opt-flag { font-size: 18px; flex-shrink: 0; }
.lang-opt-info { display: flex; flex-direction: column; gap: 1px; flex: 1; }
.lang-opt-name { font-size: 13px; font-weight: 500; }
.lang-opt-native { font-size: 11px; color: var(--text-muted); }
.lang-check { color: var(--red-light); font-size: 14px; font-weight: 700; }
.lang-no-result { padding: 20px 16px; color: var(--text-muted); font-size: 13px; text-align: center; }